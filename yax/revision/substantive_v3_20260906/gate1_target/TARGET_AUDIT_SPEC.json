  "equation_contract": {
    "coefficient_unit": "log points",
    "criterion": "N_y*log(p) + N_o*log(1-p) on rows with N_y+N_o>0",
    "forbidden_interpretations": [
      "observed log ratio in cells with a zero stock",
      "literal independent-person binomial likelihood",
      "individual employment probability",
      "employer hiring rate",
      "causal AI effect"
    ],
    "headline_parameter": "beta_5 is the Q5-versus-Q1 post-2023 change in log(mu_y/mu_o) conditional on occupation FE, calendar-month FE, and Webb-z-by-post",
    "linear_predictor": "logit(p)=log(mu_y/mu_o)=alpha_o+lambda_t+sum_q=2^5 beta_q*1{Q=q}*post+theta*WebbZ*post",
    "mean_share": "p=mu_y/(mu_y+mu_o)",
    "observed_stocks": "N_y is the ages-22-25 CPS-weighted employed stock and N_o is the ages-26-65 CPS-weighted employed stock",
    "ratio_percent_transform": "100*[exp(beta_5)-1], labeled as a conditional-mean stock-ratio change"
  },
