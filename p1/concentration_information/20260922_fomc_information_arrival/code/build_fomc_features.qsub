#!/bin/bash
#$ -P econdept
#$ -N p1_fomc_feat
#$ -l h_rt=08:00:00
#$ -l mem_per_core=16G
#$ -j y
#$ -o /project/econdept/qluo/bidirectional_information_20260922/fomc_information_arrival_20260922/logs
set -euo pipefail
BASE=/project/econdept/qluo/bidirectional_information_20260922
ROOT="$BASE/fomc_information_arrival_20260922"
SRC="$BASE/source_attribution_replication_20260922/code"
PY=/project/econdept/qluo/dbn_runtime/bin/python
mkdir -p "$ROOT/features" "$ROOT/results" "$ROOT/logs"
exec "$PY" "$ROOT/code/scc_build_fomc_features.py" \
  --download-receipt "$ROOT/raw/DOWNLOAD_RECEIPT.json" \
  --equity-builder "$SRC/scc_build_directional_features.py" \
  --base-code "$SRC/scc_build_bidirectional_features.py" \
  --es-builder "$ROOT/code/scc_build_fomc_es_features.py" \
  --equity-out "$ROOT/features/DIRECTIONAL_FEATURES_FOMC.parquet" \
  --es-out "$ROOT/features/FUTURES_FEATURES_FOMC.parquet" \
  --equity-receipt "$ROOT/results/EQUITY_FEATURE_RECEIPT.json" \
  --es-receipt "$ROOT/results/ES_FEATURE_RECEIPT.json"
