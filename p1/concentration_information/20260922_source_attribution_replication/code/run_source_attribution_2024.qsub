#!/bin/bash
#$ -P econdept
#$ -N p1_src_2024
#$ -t 1-4
#$ -l h_rt=02:00:00
#$ -l mem_per_core=8G
#$ -j y
#$ -o /project/econdept/qluo/bidirectional_information_20260922/source_attribution_replication_20260922/logs

set -euo pipefail
BASE=/project/econdept/qluo/bidirectional_information_20260922
ROOT="$BASE/source_attribution_replication_20260922"
PY=/project/econdept/qluo/dbn_runtime/bin/python
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
case "$SGE_TASK_ID" in
  1) VENUE=XNAS.ITCH; SHIFT=0 ;;
  2) VENUE=XNAS.ITCH; SHIFT=500 ;;
  3) VENUE=ARCX.PILLAR; SHIFT=0 ;;
  4) VENUE=ARCX.PILLAR; SHIFT=500 ;;
  *) exit 2 ;;
esac
OUT="$ROOT/model_parts_2024/${VENUE}_${SHIFT}"
ARTIFACT="$ROOT/frozen_2023/${VENUE}_${SHIFT}.pkl"
mkdir -p "$OUT"
exec "$PY" "$ROOT/code/run_source_attribution_cell.py" \
  --mode score \
  --stock-features "$ROOT/features_2024/DIRECTIONAL_FEATURES_2024.parquet" \
  --futures-features "$ROOT/features_2024/FUTURES_FEATURES_2024.parquet" \
  --base-code "$ROOT/code/directional_base.py" \
  --roster "$BASE/futures_control/results/SAFE_ROSTER.csv" \
  --dates "$ROOT/results/DATE_MANIFEST.csv" \
  --artifact "$ARTIFACT" --out "$OUT" --venue "$VENUE" --grid-shift "$SHIFT"
