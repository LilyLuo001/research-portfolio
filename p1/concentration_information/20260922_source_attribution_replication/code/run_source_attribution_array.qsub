#!/bin/bash
#$ -P econdept
#$ -N p1_src_attr
#$ -t 1-4
#$ -l h_rt=02:00:00
#$ -l mem_per_core=12G
#$ -j y
#$ -o /project/econdept/qluo/bidirectional_information_20260922/source_attribution_replication_20260922/logs

set -euo pipefail

BASE=/project/econdept/qluo/bidirectional_information_20260922
ROOT="$BASE/source_attribution_replication_20260922"
PY=/project/econdept/qluo/dbn_runtime/bin/python
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

case "$SGE_TASK_ID" in
  1) VENUE=XNAS.ITCH; SHIFT=0 ;;
  2) VENUE=XNAS.ITCH; SHIFT=500 ;;
  3) VENUE=ARCX.PILLAR; SHIFT=0 ;;
  4) VENUE=ARCX.PILLAR; SHIFT=500 ;;
  *) echo "unexpected SGE_TASK_ID=$SGE_TASK_ID" >&2; exit 2 ;;
esac

MODE="${RUN_MODE:-fit2023}"
if [[ "$MODE" == fit2023 ]]; then
  STOCK="$BASE/directional_evidence/features/DIRECTIONAL_FEATURES.parquet"
  FUTURES="$BASE/futures_control/features/FUTURES_FEATURES.parquet"
  DATES="$BASE/futures_control/results/DATE_MANIFEST.csv"
  OUT="$ROOT/model_parts_2023/${VENUE}_${SHIFT}"
else
  STOCK="$ROOT/features_2024/DIRECTIONAL_FEATURES_2024.parquet"
  FUTURES="$ROOT/features_2024/FUTURES_FEATURES_2024.parquet"
  DATES="$ROOT/results/DATE_MANIFEST.csv"
  OUT="$ROOT/model_parts_2024/${VENUE}_${SHIFT}"
fi
ARTIFACT="$ROOT/frozen_2023/${VENUE}_${SHIFT}.pkl"
mkdir -p "$OUT" "$(dirname "$ARTIFACT")"

exec "$PY" "$ROOT/code/run_source_attribution_cell.py" \
  --mode "$MODE" --stock-features "$STOCK" --futures-features "$FUTURES" \
  --base-code "$ROOT/code/directional_base.py" \
  --roster "$BASE/futures_control/results/SAFE_ROSTER.csv" \
  --dates "$DATES" --artifact "$ARTIFACT" --out "$OUT" \
  --venue "$VENUE" --grid-shift "$SHIFT"
