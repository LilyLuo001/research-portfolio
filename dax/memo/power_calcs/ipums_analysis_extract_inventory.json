    "codes_new_note": "RACE 817 is one additional multi-race combination and the new UHRSWORKT values are sparse hour counts that simply had no observations in the shorter window. Neither is a new semantic category.",
    "comparability_with_frozen_baseline": {
      "column_set_identical": true,
      "extract_6_months_are_an_exact_prefix": true,
      "note": "Same 20 columns in the same order, and extract 7's first 16 months reproduce extract 6 exactly. The frozen power baseline remains comparable; power_standard.json was not touched."
    },
    "empstat_beyond_10_12": {
      "answer": "YES, and it was already true of extract 6",
      "extract_6_codes": [
        "1",
        "10",
