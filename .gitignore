__pycache__/
*.pyc
.pytest_cache/
.venv/

# box-only secrets + runtime logs (never leave the always-on box)
ops/box/.env
ops/box/cron.log
ops/box/.inbox_done
ops/box/.cron.lock
ops/runner/spend_log.jsonl
# NOTE: ops/box/inbox.sh and inbox_log.md are deliberately TRACKED — they are
# the remote-hands channel (commands in, results out) between operator and box.
# L1 batch outputs — raw extraction, produced on the box… EXCEPT the debug
# surface: void post-mortems and the night report flow back through git so a
# failed night can be diagnosed from any seat, not just on the box.
ops/l1/out/*
!ops/l1/out/*.void.json
!ops/l1/out/_last_night.json
# NOTE: ops/runner/state.json is deliberately TRACKED, not ignored — completion
# and gate state must be visible to every seat's clone (the repo is the only
# shared state), or a fresh seat re-assigns finished tasks. Only spend logs and
# secrets stay box-local.
# P1 EDGAR raw filing package: hundreds of .htm files stay box-local (same
# rule as L1 raw outputs) — git carries only the manifest of locators.
p1/edgar_filings/*
!p1/edgar_filings/manifest.csv
# P1-T2 WRDS path: LICENSED DATA. Raw CRSP/Compustat/IBES pulls stay box-local —
# a stricter version of the raw-filings rule above, because this is paid data
# under a subscription agreement, not public filings. Git carries the derived
# contract output (conv_exposure.parquet: ratios and counts) plus a manifest of
# query locators (library.table, columns, filters, pull date), never rows.
# Policy + what may be committed: p1/t2_wrds/README.md. Guarded by
# p1/tests/test_wrds_data_policy.py, which fails CI if a raw pull is tracked.
p1/t2_wrds/raw/
p1/t2_wrds/cache/
p1/t2_wrds/*.raw.csv
p1/t2_wrds/*.raw.parquet

# P1-T2 free path: immutable raw-HTTP cache (N-PORT XML, XBRL, FIGI, prices)
# stays box-local, same rule as raw filings. The parquet + diagnostics + code
# are tracked; the cache is not.
p1/t2_free/cache/
# transient stdout dumps from detached runs (the FileHandler log is tracked)
p1/t2_free/*.out

# W2 price harvester: local blobless mirror of the third-party price table
dax/data_raw/_litellm_mirror/

# W2 price harvester: cached archive snapshots (re-fetchable, not source of truth)
dax/data_raw/_wayback_cache/

# P1 WRDS sprint: raw pulls are large and licensed, and discovered_schema.json is
# one connected session's machine-read inventory — both are box artifacts, not
# source. p1/wrds/pull_scope.json IS tracked: it is derived offline from
# committed files and is what you hand to whoever books the account.
p1/wrds/raw/*
p1/wrds/discovered_schema.json
# ...but the PROVENANCE sidecars are not licensed data and must reach the repo:
# each carries the exact SQL, the row count and the code version behind one
# landed parquet. Without them a pull has no locator, which is meta-rule 1's
# whole requirement. Same pattern as ops/l1/out/*.void.json above. Note the
# parent must be `raw/*`, not `raw/`: git does not reconsider files inside an
# excluded DIRECTORY, so a negation under `raw/` would never fire.
!p1/wrds/raw/*.lineage.json
!p1/wrds/raw/mf_holdings__matched_fundnos.json
# P1-T2 free path: sidecar produced at pipeline runtime — contains shares_held for
# dropped cells. Created by build_nport_convexp.py, consumed by recover_denominators.py.
# Not committed: it contains N-PORT data (which is licensed) and changes with each run.
p1/t2_free/dropped_cells_shares_held.csv
